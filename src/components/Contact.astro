---
// Web3Forms access key. Set PUBLIC_WEB3FORMS_ACCESS_KEY in a local .env file and
// in the host's environment variables (Cloudflare Pages / Netlify / etc.).
// Get a free key at https://web3forms.com by entering the inbox address that
// should receive submissions.
const WEB3FORMS_ACCESS_KEY = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
---

<section id="contact" class="contact section-dark">
  <div class="container">
    <div class="contact-content">
      <div class="contact-info">
        <p class="section-label">Get in touch</p>
        <h2>Let's Create Something Amazing</h2>
        <p class="contact-description">
          Ready to start your project? We'd love to hear from you. Send us a message and we'll respond as soon as possible.
        </p>

        <div class="contact-methods">
          <div class="contact-method">
            <h4>Email</h4>
            <a href="mailto:info@1818creative.com">info@1818creative.com</a>
          </div>
          <div class="contact-method">
            <h4>Phone</h4>
            <a href="tel:+12096076811">209.607.6811</a>
          </div>
          <div class="contact-method">
            <h4>Location</h4>
            <p>Greater Sacramento Area</p>
          </div>
        </div>
      </div>

      <form class="contact-form" id="contact-form">
        <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
        <input type="hidden" name="from_name" value="1818creative.com contact form" />
        <input
          type="checkbox"
          name="botcheck"
          class="botcheck"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />

        <div class="form-group">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" required />
        </div>

        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required />
        </div>

        <div class="form-group">
          <label for="subject">Subject</label>
          <input type="text" id="subject" name="subject" required />
        </div>

        <div class="form-group">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>

        <button type="submit" class="btn btn-light">Send Message</button>
        <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('form-status');
  const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

  function setStatus(message: string, state: 'pending' | 'success' | 'error') {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.dataset.state = state;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form) return;

    const data = Object.fromEntries(new FormData(form));

    // Honeypot: a real user never checks this hidden box.
    if (data.botcheck) return;

    if (!data.access_key) {
      setStatus(
        'The form is not configured yet. Set PUBLIC_WEB3FORMS_ACCESS_KEY, then rebuild.',
        'error',
      );
      return;
    }

    setStatus('Sending…', 'pending');
    if (submitBtn) submitBtn.disabled = true;

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(data),
      });
      const result = await res.json();

      if (res.ok && result.success) {
        form.reset();
        setStatus(
          "Thanks — your message is on its way. We'll reply within one business day.",
          'success',
        );
      } else {
        setStatus(
          result.message || 'Something went wrong. Please email info@1818creative.com.',
          'error',
        );
      }
    } catch {
      setStatus('Network error. Please email info@1818creative.com.', 'error');
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>

<style>
  .contact {
    padding: var(--spacing-xl) 0;
  }

  .contact-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .section-label {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 1rem;
  }

  .contact-info h2 {
    color: var(--color-secondary);
    margin-bottom: 1.5rem;
  }

  .contact-description {
    color: rgba(255, 255, 255, 0.7);
    font-size: 1.125rem;
    line-height: 1.8;
    margin-bottom: 3rem;
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .contact-method h4 {
    color: var(--color-secondary);
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .contact-method a,
  .contact-method p {
    color: rgba(255, 255, 255, 0.8);
    font-size: 1.125rem;
    transition: var(--transition);
  }

  .contact-method a:hover {
    color: var(--color-secondary);
  }

  .contact-form {
    background: rgba(255, 255, 255, 0.05);
    padding: 2.5rem;
    border-radius: var(--radius-card);
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  .form-group label {
    display: block;
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 0.875rem 1rem;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--color-secondary);
    font-size: 1rem;
    font-family: inherit;
    transition: var(--transition);
    border-radius: var(--radius-sm);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.15);
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 120px;
  }

  .botcheck {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .form-status {
    margin: 1rem 0 0;
    font-size: 0.95rem;
    min-height: 1.4em;
    color: rgba(255, 255, 255, 0.7);
  }

  .form-status[data-state='success'] {
    color: var(--color-volt);
  }

  .form-status[data-state='error'] {
    color: #ff9c9c;
  }

  .contact-form .btn {
    width: 100%;
    justify-content: center;
    margin-top: 0.5rem;
  }

  @media (max-width: 968px) {
    .contact-content {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .contact-form {
      padding: 2rem;
    }
  }
</style>
