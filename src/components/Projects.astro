---
const projects = [
  {
    title: 'E-commerce Platform',
    category: 'Web Development',
    description: 'A modern e-commerce solution with seamless checkout experience',
    image: '/images/projects/project-1.jpg',
  },
  {
    title: 'Mobile App Design',
    category: 'UI/UX Design',
    description: 'Intuitive mobile app design for fitness tracking',
    image: '/images/projects/project-2.jpg',
  },
  {
    title: 'Brand Photography',
    category: 'Photography',
    description: 'Professional product photography for luxury brand',
    image: '/images/projects/project-3.jpg',
  },
  {
    title: 'Social Campaign',
    category: 'Marketing',
    description: 'Viral social media campaign reaching 1M+ users',
    image: '/images/projects/project-4.jpg',
  },
];
---

<section id="projects" class="projects section">
  <div class="container">
    <div class="section-header">
      <p class="section-label">Our Work</p>
      <h2>Recent Projects</h2>
      <p class="section-description">
        A showcase of our latest work across design, development, and marketing
      </p>
    </div>

    <div class="projects-grid">
      {projects.map((project, index) => (
        <article class="project-card" style={`animation-delay: ${index * 0.1}s`}>
          <div class="project-image">
            <img src={project.image} alt={project.title} loading="lazy" />
            <div class="project-overlay">
              <span>{project.category}</span>
            </div>
          </div>
          <div class="project-content">
            <span class="project-category">{project.category}</span>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <a href="#" class="project-link">View Project →</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .projects {
    background: var(--color-mist);
  }

  .section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 4rem;
  }

  .section-label {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-text-light);
    margin-bottom: 1rem;
  }

  .section-description {
    font-size: 1.125rem;
    color: var(--color-text-light);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .project-card {
    background: var(--color-white);
    border: 1px solid var(--color-ash);
    border-radius: var(--radius-card);
    overflow: hidden;
    transition: var(--transition);
    animation: fadeIn 0.6s ease-out forwards;
    opacity: 0;
  }

  .project-card:hover {
    transform: translateY(-5px);
    border-color: var(--color-black);
  }

  .project-image {
    aspect-ratio: 16/10;
    overflow: hidden;
    background: var(--color-graphite);
    position: relative;
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition);
  }

  .project-overlay {
    position: absolute;
    top: 1rem;
    left: 1rem;
    right: auto;
    bottom: auto;
    background: var(--color-mint);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-black);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-tag);
    opacity: 0;
    transition: var(--transition);
  }

  .project-card:hover .project-image img {
    transform: scale(1.05);
  }

  .project-card:hover .project-overlay {
    opacity: 1;
  }

  .project-content {
    padding: 2rem;
  }

  .project-category {
    display: inline-block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-light);
    margin-bottom: 1rem;
  }

  .project-card h3 {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .project-card p {
    color: var(--color-text-light);
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-primary);
    font-weight: 500;
    transition: var(--transition);
  }

  .project-link:hover {
    transform: translateX(5px);
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
