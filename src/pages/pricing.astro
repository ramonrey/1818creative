---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cta from '../components/Cta.astro';

// PLACEHOLDER CONTENT — structure mirrors oneeleven.surf/pricing.
// Plan names, prices and copy are stand-ins for review.
const plans = [
  {
    name: 'Build',
    price: '$400',
    cadence: '/month',
    tagline: 'For businesses ready for their first professionally managed website.',
    features: [
      'Custom-designed, mobile-responsive website',
      'Managed hosting with SSL, CDN and daily backups',
      'Unlimited content edits, 2 business-day turnaround',
      'Software, security and uptime monitoring',
      'Technical SEO setup and Google Analytics 4',
      'WCAG 2.1 AA accessibility',
      'Email support',
    ],
    cta: 'Get started',
    popular: false,
  },
  {
    name: 'Grow',
    price: '$750',
    cadence: '/month',
    tagline: 'Our most popular plan for growing businesses.',
    features: [
      'Everything in Build, plus:',
      '2 hours of design and dev time each month',
      'Google Business Profile and local SEO management',
      'One optimised landing page or blog post per month',
      'Staging site for testing changes',
      'Conversion and goal tracking',
      'Monthly traffic and conversion report',
    ],
    cta: 'Get started',
    popular: true,
  },
  {
    name: 'Scale',
    price: '$2,550',
    cadence: '/month',
    tagline: 'A complete marketing partnership for established organisations.',
    features: [
      'Everything in Grow, plus:',
      'Monthly email newsletter, built and sent',
      'Social media management, up to 3 channels',
      'Google or Meta Ads management (ad spend billed separately)',
      'Quarterly strategy session with your account lead',
      'Quarterly accessibility and performance audit',
      'Dedicated account manager',
    ],
    cta: 'Get started',
    popular: false,
  },
];

const addOns = [
  {
    title: 'Extra page or landing page',
    price: 'From $450 / page',
    description: 'Designed and built to match your existing site.',
  },
  {
    title: 'Online store setup',
    price: 'From $2,500 / project',
    description: 'Shopify or WooCommerce with products, payments and shipping configured.',
  },
  {
    title: 'Brand identity',
    price: 'From $2,200 / project',
    description: 'Logo, colour, type and a short brand guidelines doc.',
  },
  {
    title: 'Product photography',
    price: 'From $550 / day',
    description: 'A half or full day on location, edited and web-ready.',
  },
  {
    title: 'Platform migration',
    price: 'From $1,500 / project',
    description: 'Move off Wix, Squarespace or old WordPress with redirects and SEO kept intact.',
  },
  {
    title: 'Accessibility audit + VPAT',
    price: 'From $1,800 / project',
    description: 'A full WCAG 2.1 audit, a fix list, and a VPAT for procurement.',
  },
];
---

<Layout
  title="Pricing - 1818 Agency"
  description="Transparent pricing and flexible plans for professionally managed websites and marketing."
>
  <Header />

  <main>
    <section class="pricing-hero">
      <div class="container">
        <p class="hero-label">Pricing</p>
        <h1>Website plans</h1>
        <p>
          Transparent pricing and flexible plans that grow with your business. Every
          tier is one flat monthly fee covering your website, hosting, and unlimited
          updates. There's no large upfront cost, and you can move up a tier whenever
          you need more.
        </p>
      </div>
    </section>

    <section class="plans section">
      <div class="container">
        <div class="plans-grid">
          {plans.map((plan) => (
            <article class={`plan-card${plan.popular ? ' popular' : ''}`}>
              {plan.popular && <span class="plan-badge">Most popular</span>}
              <h3 class="plan-name">{plan.name}</h3>
              <p class="plan-price">
                <span class="plan-amount">{plan.price}</span>
                <span class="plan-cadence">{plan.cadence}</span>
              </p>
              <p class="plan-tagline">{plan.tagline}</p>
              <ul class="plan-features">
                {plan.features.map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>
              <a href="/#contact" class={`btn${plan.popular ? '' : ' btn-ghost'} plan-cta`}>
                {plan.cta}
              </a>
            </article>
          ))}
        </div>
        <p class="plans-note">Billed monthly. No long-term contracts — cancel anytime.</p>
      </div>
    </section>

    <section class="custom section">
      <div class="container">
        <div class="custom-panel">
          <div class="custom-copy">
            <p class="section-label">Custom solutions</p>
            <h2>Bigger project? Let's scope it</h2>
            <p>
              The plans above cover most small and mid-sized businesses. If yours needs
              custom functionality or a bigger build than the tiers allow, we'll work
              out the scope and send you a quote. You'll know the full cost before any
              work starts.
            </p>
          </div>
          <a href="/#contact" class="btn btn-light">Let's talk →</a>
        </div>
      </div>
    </section>

    <section class="addons section">
      <div class="container">
        <div class="section-header">
          <p class="section-label">Add-ons</p>
          <h2>Extend any plan</h2>
          <p class="section-description">
            Modular services you can bolt on to any plan as your needs change.
          </p>
        </div>
        <div class="addons-grid">
          {addOns.map((addOn) => (
            <article class="addon-card">
              <div class="addon-header">
                <h2>{addOn.title}</h2>
                <span class="addon-price">{addOn.price}</span>
              </div>
              <p>{addOn.description}</p>
              <a href="/#contact" class="addon-link">Request a quote →</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <Cta />
  </main>

  <Footer />
</Layout>

<style>
  .pricing-hero {
    padding: calc(82px + 6rem) 0 4rem;
    text-align: center;
    background: var(--color-volt);
  }

  .pricing-hero .hero-label {
    color: var(--color-black);
    opacity: 0.65;
    margin-bottom: 1rem;
  }

  .pricing-hero h1 {
    color: var(--color-black);
    margin-bottom: 1.5rem;
  }

  .pricing-hero p {
    color: var(--color-black);
    text-align: center;
    max-width: 58ch;
    margin: 0 auto;
    font-size: 1.15rem;
    line-height: 1.7;
  }

  /* Plans */
  .plans-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    align-items: stretch;
  }

  .plan-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 2.5rem;
    background: var(--color-white);
    border: 2px solid var(--color-ash);
    border-radius: var(--radius-card);
    transition: var(--transition);
  }

  .plan-card:hover {
    border-color: var(--color-black);
    transform: translateY(-5px);
  }

  .plan-card.popular {
    border: 2px solid var(--color-black);
  }

  .plan-badge {
    position: absolute;
    top: -0.85rem;
    left: 2.5rem;
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.9rem;
    background: var(--color-volt);
    color: var(--color-black);
    border-radius: var(--radius-tag);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .plan-name {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .plan-price {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }

  .plan-amount {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-black);
  }

  .plan-cadence {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-smoke);
  }

  .plan-tagline {
    color: var(--color-text-light);
    margin-bottom: 1.5rem;
  }

  .plan-features {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    flex: 1;
  }

  .plan-features li {
    padding: 0.5rem 0 0.5rem 1.5rem;
    color: var(--color-text);
    position: relative;
  }

  .plan-features li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-primary);
  }

  .plan-cta {
    width: 100%;
    justify-content: center;
  }

  .plans-note {
    text-align: center;
    max-width: none;
    margin: 2.5rem auto 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-smoke);
  }

  /* Custom solutions */
  .custom {
    background: var(--color-canvas);
  }

  .custom-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
    padding: 3rem;
    background: var(--color-black);
    color: var(--color-white);
    border-radius: var(--radius-card);
  }

  .custom-panel .section-label {
    color: var(--color-white);
    opacity: 0.6;
    margin-bottom: 1rem;
  }

  .custom-panel h2 {
    color: var(--color-white);
    margin-bottom: 1rem;
  }

  .custom-panel p {
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 0;
  }

  .custom-panel .btn-light {
    flex-shrink: 0;
  }

  /* Add-ons */
  .section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 4rem;
  }

  .section-header .section-label {
    color: var(--color-text-light);
    margin-bottom: 1rem;
  }

  .section-description {
    font-size: 1.125rem;
    color: var(--color-text-light);
  }

  .addons-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .addon-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 2rem;
    background: var(--color-white);
    border: 2px solid var(--color-ash);
    border-radius: var(--radius-card);
    transition: var(--transition);
  }

  .addon-card:hover {
    border-color: var(--color-black);
    transform: translateY(-5px);
  }

  .addon-header {
    margin-bottom: 1rem;
  }

  .addon-card h2 {
    font-size: 1.15rem;
    line-height: 1.2;
    text-transform: none;
    letter-spacing: -0.01em;
    margin-bottom: 0.4rem;
  }

  .addon-price {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-smoke);
  }

  .addon-card p {
    color: var(--color-text-light);
    font-size: 0.95rem;
    margin-bottom: 1.25rem;
    flex: 1;
  }

  .addon-link {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }

  .addon-link:hover {
    opacity: 0.6;
  }

  /* Tablet — keep 3 columns but tighten so nothing overflows */
  @media (max-width: 1080px) {
    .plans-grid {
      gap: 1.25rem;
    }

    .plan-card {
      padding: 1.75rem;
    }

    .plan-badge {
      left: 1.75rem;
    }

    .plan-amount {
      font-size: 2.5rem;
    }
  }

  /* Stack into a single centred column */
  @media (max-width: 860px) {
    .plans-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
      max-width: 460px;
      margin: 0 auto;
    }

    .plan-card {
      padding: 2.5rem;
    }

    .plan-badge {
      left: 2.5rem;
    }
  }

  @media (max-width: 968px) {
    .custom-panel {
      flex-direction: column;
      align-items: flex-start;
      padding: 2.5rem;
    }
  }

  @media (max-width: 480px) {
    .plan-card {
      padding: 1.75rem;
    }

    .plan-badge {
      left: 1.75rem;
    }
  }
</style>
