---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const products = await getCollection('shop');
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await render(product);
---

<Layout title={`${product.data.title} - Digital Shop`} description={product.data.description}>
  <Header />

  <main>
    <article class="product-detail">
      <section class="product-hero section">
        <div class="container">
          <div class="product-layout">
            <div class="product-image-main">
              <img src={product.data.image} alt={product.data.title} />
            </div>

            <div class="product-info">
              <span class="product-category">{product.data.category.replace('-', ' ')}</span>
              <h1>{product.data.title}</h1>
              <p class="product-description">{product.data.description}</p>

              <div class="product-price-section">
                <span class="product-price">${product.data.price}</span>
                <button class="btn">Purchase Now</button>
              </div>

              {product.data.previewLink && (
                <a href={product.data.previewLink} target="_blank" rel="noopener" class="preview-link">
                  View Live Preview →
                </a>
              )}

              <div class="product-tags">
                {product.data.tags.map(tag => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="product-content section">
        <div class="container">
          <div class="content-wrapper">
            <Content />
          </div>
        </div>
      </section>

      <section class="product-footer section">
        <div class="container">
          <a href="/shop" class="back-link">← Back to Shop</a>
        </div>
      </section>
    </article>
  </main>

  <Footer />
</Layout>

<style>
  .product-hero {
    padding-top: 7rem;
  }

  .product-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .product-image-main {
    position: sticky;
    top: 120px;
  }

  .product-image-main img {
    width: 100%;
    border-radius: 4px;
    border: 1px solid rgba(0, 0, 0, 0.1);
  }

  .product-info {
    padding-top: 2rem;
  }

  .product-category {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: rgba(0, 0, 0, 0.05);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 2px;
    margin-bottom: 1.5rem;
  }

  .product-info h1 {
    margin-bottom: 1.5rem;
  }

  .product-description {
    font-size: 1.125rem;
    color: var(--color-text-light);
    line-height: 1.8;
    margin-bottom: 2rem;
  }

  .product-price-section {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 2rem 0;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    margin-bottom: 1.5rem;
  }

  .product-price {
    font-size: 2.5rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .preview-link {
    display: inline-block;
    color: var(--color-primary);
    font-weight: 500;
    margin-bottom: 2rem;
    transition: var(--transition);
  }

  .preview-link:hover {
    transform: translateX(5px);
  }

  .product-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: rgba(0, 0, 0, 0.05);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 2px;
  }

  .product-content {
    background: rgba(0, 0, 0, 0.02);
  }

  .content-wrapper {
    max-width: 800px;
    margin: 0 auto;
  }

  .content-wrapper :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1.5rem;
    font-size: 2rem;
  }

  .content-wrapper :global(h3) {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-size: 1.5rem;
  }

  .content-wrapper :global(p) {
    margin-bottom: 1.5rem;
    line-height: 1.8;
    color: var(--color-text);
  }

  .content-wrapper :global(ul) {
    margin-bottom: 1.5rem;
    padding-left: 2rem;
  }

  .content-wrapper :global(li) {
    margin-bottom: 0.75rem;
    line-height: 1.8;
  }

  .product-footer {
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-primary);
    font-weight: 500;
    transition: var(--transition);
  }

  .back-link:hover {
    transform: translateX(-5px);
  }

  @media (max-width: 968px) {
    .product-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .product-image-main {
      position: static;
    }

    .product-info {
      padding-top: 0;
    }

    .product-price-section {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }
</style>
