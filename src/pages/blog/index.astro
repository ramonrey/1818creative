---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { urlFor } from '../../sanity/lib/image';
import { getPosts } from '../../sanity/lib/posts';
import type { PostListItem } from '../../sanity/lib/types';

const sortedPosts = await getPosts();
const featuredPosts = sortedPosts.filter((post) => post.featured);

const cardImage = (post: PostListItem) =>
  post.mainImage?.asset ? urlFor(post.mainImage).width(760).height(428).fit('crop').auto('format').url() : null;

const formatLong = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const formatShort = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<Layout title="Blog - 1818 Agency" description="Notes on web design, branding, and marketing from the 1818 Creative team.">
  <Header />

  <main>
    <section class="blog-hero">
      <div class="container">
        <h1>Our Blog</h1>
        <p>Insights, tutorials, and updates from the 1818 team</p>
      </div>
    </section>

    {featuredPosts.length > 0 && (
      <section class="featured-posts section">
        <div class="container">
          <h2>Featured Articles</h2>
          <div class="featured-grid">
            {featuredPosts.map((post) => (
              <article class="featured-card">
                <a href={`/blog/${post.slug}`}>
                  {cardImage(post) && (
                    <div class="featured-image">
                      <img src={cardImage(post)} alt={post.mainImage?.alt || post.title} />
                    </div>
                  )}
                  <div class="featured-content">
                    <div class="post-meta">
                      <time datetime={post.publishedAt}>{formatLong(post.publishedAt)}</time>
                      <span>•</span>
                      <span>{post.author}</span>
                    </div>
                    <h3>{post.title}</h3>
                    <p>{post.description}</p>
                    <div class="post-tags">
                      {(post.tags ?? []).map((tag) => (
                        <span class="tag">{tag}</span>
                      ))}
                    </div>
                  </div>
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="all-posts section">
      <div class="container">
        <h2>All Articles</h2>
        <div class="posts-grid">
          {sortedPosts.map((post) => (
            <article class="post-card">
              <a href={`/blog/${post.slug}`}>
                {cardImage(post) && (
                  <div class="post-image">
                    <img src={cardImage(post)} alt={post.mainImage?.alt || post.title} loading="lazy" />
                  </div>
                )}
                <div class="post-content">
                  <div class="post-meta">
                    <time datetime={post.publishedAt}>{formatShort(post.publishedAt)}</time>
                  </div>
                  <h3>{post.title}</h3>
                  <p>{post.description}</p>
                  <div class="post-tags">
                    {(post.tags ?? []).map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .blog-hero {
    padding: calc(82px + 6rem) 0 4rem;
    min-height: 447px;
    text-align: center;
    background: var(--feature-bg);
  }

  .blog-hero h1 {
    color: var(--feature-fg);
    margin-bottom: 1.5rem;
  }

  .blog-hero p {
    color: var(--feature-muted);
    text-align: center;
    max-width: none;
    font-size: 1.25rem;
    line-height: 1.8;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .featured-card {
    background: var(--surface);
    border: 1px solid var(--border);
    overflow: hidden;
    transition: var(--transition);
  }

  .featured-card:hover {
    transform: translateY(-5px);
    border-color: var(--border-strong);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .featured-image {
    aspect-ratio: 16/9;
    overflow: hidden;
    background: var(--surface-alt);
  }

  .featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition);
  }

  .featured-card:hover .featured-image img {
    transform: scale(1.05);
  }

  .featured-content {
    padding: 2rem;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .post-card {
    background: var(--surface);
    border: 1px solid var(--border);
    overflow: hidden;
    transition: var(--transition);
  }

  .post-card:hover {
    border-color: var(--border-strong);
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
  }

  .post-image {
    aspect-ratio: 16/9;
    overflow: hidden;
    background: var(--surface-alt);
  }

  .post-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition);
  }

  .post-card:hover .post-image img {
    transform: scale(1.05);
  }

  .post-content {
    padding: 1.5rem;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .post-card h3,
  .featured-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
    color: var(--heading);
  }

  .post-card p,
  .featured-card p {
    color: var(--muted);
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: var(--surface-alt);
    color: var(--muted);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 2px;
  }

  @media (max-width: 768px) {

    .featured-grid,
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
