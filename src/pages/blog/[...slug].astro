---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout title={`${post.data.title} - 1818 Agency`} description={post.data.description}>
  <Header />

  <main>
    <article class="blog-post">
      <header class="post-header section-dark">
        <div class="container">
          <div class="post-meta">
            <time>{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
            <span>•</span>
            <span>{post.data.author}</span>
          </div>
          <h1>{post.data.title}</h1>
          <p class="post-description">{post.data.description}</p>
          <div class="post-tags">
            {post.data.tags.map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </div>
      </header>

      {post.data.image && (
        <div class="post-featured-image">
          <div class="container">
            <img src={post.data.image} alt={post.data.title} />
          </div>
        </div>
      )}

      <div class="post-content">
        <div class="container">
          <div class="content-wrapper">
            <Content />
          </div>
        </div>
      </div>

      <div class="post-footer">
        <div class="container">
          <a href="/blog" class="back-link">← Back to Blog</a>
        </div>
      </div>
    </article>
  </main>

  <Footer />
</Layout>

<style>
  .post-header {
    padding: 8rem 0 4rem;
    text-align: center;
  }

  .post-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 1.5rem;
  }

  .post-header h1 {
    color: var(--color-secondary);
    margin-bottom: 1.5rem;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .post-description {
    color: rgba(255, 255, 255, 0.8);
    font-size: 1.25rem;
    max-width: 700px;
    margin: 0 auto 2rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  .tag {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 2px;
  }

  .post-featured-image {
    padding: 3rem 0;
    background: var(--color-bg);
  }

  .post-featured-image img {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    border-radius: 4px;
  }

  .post-content {
    padding: 4rem 0;
  }

  .content-wrapper {
    max-width: 750px;
    margin: 0 auto;
  }

  .content-wrapper :global(h2) {
    margin-top: 3rem;
    margin-bottom: 1.5rem;
    font-size: 2rem;
  }

  .content-wrapper :global(h3) {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-size: 1.5rem;
  }

  .content-wrapper :global(p) {
    margin-bottom: 1.5rem;
    line-height: 1.8;
    color: var(--color-text);
    max-width: 100%;
  }

  .content-wrapper :global(ul),
  .content-wrapper :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 2rem;
  }

  .content-wrapper :global(li) {
    margin-bottom: 0.75rem;
    line-height: 1.8;
  }

  .content-wrapper :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .content-wrapper :global(a:hover) {
    opacity: 0.7;
  }

  .content-wrapper :global(code) {
    background: rgba(0, 0, 0, 0.05);
    padding: 0.2rem 0.4rem;
    border-radius: 3px;
    font-size: 0.9em;
    font-family: 'Courier New', monospace;
  }

  .content-wrapper :global(pre) {
    background: var(--color-accent);
    color: var(--color-secondary);
    padding: 1.5rem;
    border-radius: 4px;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }

  .content-wrapper :global(blockquote) {
    border-left: 4px solid var(--color-primary);
    padding-left: 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: var(--color-text-light);
  }

  .post-footer {
    padding: 3rem 0 4rem;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-primary);
    font-weight: 500;
    transition: var(--transition);
  }

  .back-link:hover {
    transform: translateX(-5px);
  }

  @media (max-width: 768px) {
    .post-header {
      padding: 6rem 0 3rem;
    }

    .content-wrapper :global(h2) {
      font-size: 1.75rem;
    }
  }
</style>
