---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { sanityClient } from '../../sanity/lib/client';
import { urlFor } from '../../sanity/lib/image';
import { renderBody } from '../../sanity/lib/portableText';
import type { Post } from '../../sanity/lib/types';

export async function getStaticPaths() {
  const posts = await sanityClient.fetch<Post[]>(`
    *[_type == "post" && defined(slug.current)]{
      _id, title, "slug": slug.current, description, publishedAt,
      author, tags, featured, mainImage, body
    }
  `);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const bodyHtml = renderBody(post.body);
const heroImage = post.mainImage?.asset
  ? urlFor(post.mainImage).width(1200).fit('max').auto('format').url()
  : null;
---

<Layout title={`${post.title} - 1818 Agency`} description={post.description}>
  <Header />

  <main>
    <article class="blog-post">
      <header class="post-header section-dark">
        <div class="container">
          <div class="post-meta">
            <time datetime={post.publishedAt}>
              {new Date(post.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <span>•</span>
            <span>{post.author}</span>
          </div>
          <h1>{post.title}</h1>
          <p class="post-description">{post.description}</p>
          <div class="post-tags">
            {(post.tags ?? []).map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </div>
      </header>

      {heroImage && (
        <div class="post-featured-image">
          <div class="container">
            <img src={heroImage} alt={post.mainImage?.alt || post.title} />
          </div>
        </div>
      )}

      <div class="post-content">
        <div class="container">
          <div class="content-wrapper" set:html={bodyHtml} />
        </div>
      </div>

      <div class="post-footer">
        <div class="container">
          <a href="/blog" class="back-link">← Back to Blog</a>
        </div>
      </div>
    </article>
  </main>

  <Footer />
</Layout>

<style>
  .post-header {
    padding: 8rem 0 4rem;
    text-align: center;
  }

  .post-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--invert-muted);
    margin-bottom: 1.5rem;
  }

  .post-header h1 {
    color: var(--invert-fg);
    margin-bottom: 1.5rem;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .post-description {
    color: var(--invert-muted);
    font-size: 1.25rem;
    max-width: 700px;
    margin: 0 auto 2rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  .tag {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 2px;
  }

  .post-featured-image {
    padding: 3rem 0;
    background: var(--bg);
  }

  .post-featured-image img {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    border-radius: 4px;
  }

  .post-content {
    padding: 4rem 0;
  }

  .content-wrapper {
    max-width: 750px;
    margin: 0 auto;
  }

  .content-wrapper :global(h2) {
    margin-top: 3rem;
    margin-bottom: 1.5rem;
    font-size: 2rem;
  }

  .content-wrapper :global(h3) {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-size: 1.5rem;
  }

  .content-wrapper :global(p) {
    margin-bottom: 1.5rem;
    line-height: 1.8;
    color: var(--fg);
    max-width: 100%;
  }

  .content-wrapper :global(ul),
  .content-wrapper :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 2rem;
  }

  .content-wrapper :global(li) {
    margin-bottom: 0.75rem;
    line-height: 1.8;
  }

  .content-wrapper :global(img) {
    width: 100%;
    border-radius: 4px;
    margin: 2rem 0;
  }

  .content-wrapper :global(a) {
    color: var(--heading);
    text-decoration: underline;
  }

  .content-wrapper :global(a:hover) {
    opacity: 0.7;
  }

  .content-wrapper :global(code) {
    background: var(--surface-alt);
    padding: 0.2rem 0.4rem;
    border-radius: 3px;
    font-size: 0.9em;
    font-family: 'Courier New', monospace;
  }

  .content-wrapper :global(pre) {
    background: var(--invert-bg);
    color: var(--invert-fg);
    padding: 1.5rem;
    border-radius: 4px;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }

  .content-wrapper :global(blockquote) {
    border-left: 4px solid var(--border-strong);
    padding-left: 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: var(--muted);
  }

  .post-footer {
    padding: 3rem 0 4rem;
    border-top: 1px solid var(--border);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--heading);
    font-weight: 500;
    transition: var(--transition);
  }

  .back-link:hover {
    transform: translateX(-5px);
  }

  @media (max-width: 768px) {
    .post-header {
      padding: 6rem 0 3rem;
    }

    .content-wrapper :global(h2) {
      font-size: 1.75rem;
    }
  }
</style>
