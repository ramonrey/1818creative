---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const resources = await getCollection('resources');
  return resources.map((resource) => ({
    params: { slug: resource.id },
    props: { resource },
  }));
}

const { resource } = Astro.props;
const { Content } = await render(resource);
---

<Layout title={`${resource.data.title} - Free Resources`} description={resource.data.description}>
  <Header />

  <main>
    <article class="resource-detail">
      <section class="resource-hero section">
        <div class="container">
          <div class="resource-layout">
            <div class="resource-image-main">
              <img src={resource.data.image} alt={resource.data.title} />
              <div class="free-badge">FREE DOWNLOAD</div>
            </div>

            <div class="resource-info">
              <span class="resource-category">{resource.data.category.replace('-', ' ')}</span>
              <h1>{resource.data.title}</h1>
              <p class="resource-description">{resource.data.description}</p>

              <div class="resource-details">
                {resource.data.fileSize && (
                  <div class="detail-item">
                    <span class="detail-label">File Size:</span>
                    <span class="detail-value">{resource.data.fileSize}</span>
                  </div>
                )}
                {resource.data.fileType && (
                  <div class="detail-item">
                    <span class="detail-label">Format:</span>
                    <span class="detail-value">{resource.data.fileType}</span>
                  </div>
                )}
              </div>

              <a href={resource.data.downloadLink} class="btn download-btn" download>
                Download Free
              </a>

              <div class="resource-tags">
                {resource.data.tags.map(tag => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="resource-content section">
        <div class="container">
          <div class="content-wrapper">
            <Content />
          </div>
        </div>
      </section>

      <section class="resource-footer section">
        <div class="container">
          <a href="/resources" class="back-link">← Back to Resources</a>
        </div>
      </section>
    </article>
  </main>

  <Footer />
</Layout>

<style>
  .resource-hero {
    padding-top: 7rem;
  }

  .resource-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .resource-image-main {
    position: sticky;
    top: 120px;
  }

  .resource-image-main img {
    width: 100%;
    border-radius: 4px;
    border: 1px solid var(--border);
    margin-bottom: 1.5rem;
  }

  .free-badge {
    display: inline-block;
    padding: 1rem 2rem;
    background: var(--accent);
    color: var(--accent-fg);
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-radius: 2px;
    width: 100%;
    text-align: center;
  }

  .resource-info {
    padding-top: 2rem;
  }

  .resource-category {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: var(--surface-alt);
    color: var(--muted);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 2px;
    margin-bottom: 1.5rem;
  }

  .resource-info h1 {
    margin-bottom: 1.5rem;
  }

  .resource-description {
    font-size: 1.125rem;
    color: var(--muted);
    line-height: 1.8;
    margin-bottom: 2rem;
  }

  .resource-details {
    padding: 1.5rem;
    background: var(--surface-alt);
    border-radius: 4px;
    margin-bottom: 2rem;
  }

  .detail-item {
    display: flex;
    justify-content: space-between;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
  }

  .detail-item:last-child {
    border-bottom: none;
  }

  .detail-label {
    font-weight: 500;
    color: var(--fg);
  }

  .detail-value {
    color: var(--muted);
  }

  .download-btn {
    width: 100%;
    justify-content: center;
    padding: 1.25rem 2rem;
    font-size: 1rem;
    margin-bottom: 2rem;
  }

  .download-btn:hover {
    background: var(--btn-bg-hover);
    color: var(--btn-fg);
  }

  .resource-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: var(--surface-alt);
    color: var(--muted);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 2px;
  }

  .resource-content {
    background: var(--surface-alt);
  }

  .content-wrapper {
    max-width: 800px;
    margin: 0 auto;
  }

  .content-wrapper :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1.5rem;
    font-size: 2rem;
  }

  .content-wrapper :global(h3) {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-size: 1.5rem;
  }

  .content-wrapper :global(p) {
    margin-bottom: 1.5rem;
    line-height: 1.8;
    color: var(--fg);
  }

  .content-wrapper :global(ul) {
    margin-bottom: 1.5rem;
    padding-left: 2rem;
  }

  .content-wrapper :global(li) {
    margin-bottom: 0.75rem;
    line-height: 1.8;
  }

  .resource-footer {
    border-top: 1px solid var(--border);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--heading);
    font-weight: 500;
    transition: var(--transition);
  }

  .back-link:hover {
    transform: translateX(-5px);
  }

  @media (max-width: 968px) {
    .resource-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .resource-image-main {
      position: static;
    }

    .resource-info {
      padding-top: 0;
    }
  }
</style>
