# Copy to .env and fill in. The contact form (src/components/Contact.astro)
# posts to Web3Forms. Get a free access key at https://web3forms.com by
# entering the inbox address that should receive submissions.
# In production, set this same variable in the host's environment settings
# (Cloudflare Pages / Netlify / etc.) so it is present at build time.
PUBLIC_WEB3FORMS_ACCESS_KEY=
