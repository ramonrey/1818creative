# Copy to .env and fill in.
# In production, set these same variables in the Cloudflare Pages project
# (Settings -> Environment variables) so they are present at build time.

# --- Contact form ---------------------------------------------------------
# src/components/Contact.astro posts to Web3Forms. Get a free access key at
# https://web3forms.com by entering the inbox address that should receive
# submissions.
PUBLIC_WEB3FORMS_ACCESS_KEY=

# --- Sanity (blog CMS) ---------------------------------------------------
# The project id from sanity.io/manage (or `npm create sanity@latest`).
# "production" is the default dataset name.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2024-10-01
